# Flask Configuration
SECRET_KEY=royal_placement_super_secret_key_2026_change_in_prod
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration (MySQL 8+)
# Set your MySQL credentials below:
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=college_placement_db

# Fallback Mode:
# If MySQL is not reachable or credentials are not yet set, the app will gracefully fallback
# to SQLite (college_placement.db) so you can immediately preview and test everything!
# Set USE_SQLITE=True to force SQLite mode for offline development/testing.
USE_SQLITE=False
